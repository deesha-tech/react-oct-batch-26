# Copy to .env.local and edit. .env.local is git-ignored (*.local in .gitignore)
# and overrides .env. Restart `npm run dev` after changing env files.

# Exposed to client code as import.meta.env.VITE_* — PUBLIC, inlined into the JS bundle.
VITE_APP_TITLE=Helpdesk (local)
VITE_SUPPORT_EMAIL=you@example.com

# Not exposed: no VITE_ prefix. Readable in vite.config.ts via loadEnv(), never in src/.
# A real secret still does not belong in a SPA's env at all — it needs a server.
HELPDESK_BUILD_NOTE=only-node-sees-this
