# Committed, PUBLIC defaults. Per-machine overrides go in .env.local (git-ignored).
# Only VITE_-prefixed names reach the browser bundle — and anything that does is public.
VITE_APP_TITLE=Helpdesk
VITE_SUPPORT_EMAIL=support@helpdesk.test

# No VITE_ prefix: available to vite.config.ts / Node, never to src/ code.
HELPDESK_BUILD_NOTE=only-node-sees-this
